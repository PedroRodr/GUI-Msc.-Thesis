       <string notr="true">/* General Frame Styling */
QFrame {
    background-color: #3B4252;  /* Dark background */
    border: 2px solid #4C566A; /* Subtle border */
    border-radius: 8px;
}

/* Frame with Sunken Style */
QFrame[sunken=&quot;true&quot;] {
    border: 2px inset #4C566A;
}

/* Frame with Raised Style */
QFrame[raised=&quot;true&quot;] {
    border: 2px outset #4C566A;
}

/* Styling for a Specific Frame Object (Replace 'myFrame' with your object name) */
#myFrame {
    background-color: #434C5E;
    border: 2px solid #88C0D0;
    border-radius: 10px;
}</string>
