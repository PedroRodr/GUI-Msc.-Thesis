      <property name="styleSheet">
       <string notr="true">/* Entire QTabWidget */
QTabWidget::pane {
    background-color: #3B4252; /* Dark background */
    border: 2px solid #4C566A; /* Single border */
    border-radius: 8px;
}

/* Tab Bar (Unselected Tabs) */
QTabBar::tab {
    background: #3B4252;
    color: #D8DEE9;
    padding: 8px 20px;  /* Same padding for both selected and unselected */
    border-radius: 8px 8px 0px 0px; /* Only top corners rounded */
    border: none; /* Removes extra borders */
    margin-right: 2px;
    min-width: 100px; /* Ensures consistent width */
}

/* Selected Tab */
QTabBar::tab:selected {
    background: #88C0D0;
    color: #2E3440;
    font-weight: bold;
    padding: 8px 20px; /* Same padding for both selected and unselected */
    border-bottom: none; /* Removes extra bottom border */
    min-width: 100px; /* Keeps the width consistent with unselected tabs */
}

/* Hover Effect */
QTabBar::tab:hover {
    background: #5E81AC;
    color: #ECEFF4;
}

/* Pressed Effect */
QTabBar::tab:pressed {
    background: #81A1C1;
    color: #2E3440;
}

/* Content Area */
QWidget {
    background-color: #3B4252;
    border: none; /* Ensures no extra borders */
    border-radius: 6px;
}
</string>
