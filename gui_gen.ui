        <property name="styleSheet">
         <string notr="true">/* QRadioButton */
QRadioButton {
    color: #D8DEE9;
    font-size: 14px;
    padding: 4px;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #4C566A;
    background: #3B4252;
}

QRadioButton::indicator:checked {
    background: #88C0D0;
    border: 2px solid #88C0D0;
}
</string>
